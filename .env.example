# =============================================
# REQUIRED: Copy to .env and fill in values
# =============================================

# ── SUPABASE ──
# Get from: supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# ── DATABASE (Supabase PostgreSQL) ──
# Get from: supabase.com → Your Project → Settings → Database → Connection string
#
# Use the "Session" pooler URL (port 5432) — works for both Prisma migrations AND runtime.
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ── EMAIL (Gmail SMTP — optional, for RFQ notifications) ──
# Enable 2FA on Gmail → App Passwords → Generate password
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-gmail@gmail.com"
EMAIL_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="Mr. Ismail Trading <your-gmail@gmail.com>"
ADMIN_EMAIL="sales@ataswg.com"

# ── SITE ──
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"
NEXT_PUBLIC_WHATSAPP_NUMBER="+971501234567"
