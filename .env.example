# =============================================
# REQUIRED: Copy to .env and fill in values
# =============================================

# ── DATABASE (Neon PostgreSQL for production) ──
# Get from: https://neon.tech → New Project → Connection String
# Use "Pooled connection" URL for DATABASE_URL
# Use "Direct connection" URL for DIRECT_URL
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# For LOCAL development only (SQLite):
# DATABASE_URL="file:./dev.db"

# ── NEXTAUTH ──
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-change-this"
# For Vercel: set this to your Vercel domain → https://your-app.vercel.app
# For local: http://localhost:3000
NEXTAUTH_URL="https://your-app.vercel.app"

# ── EMAIL (Gmail SMTP) ──
# Enable 2FA on Gmail → App Passwords → Generate password
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-gmail@gmail.com"
EMAIL_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="Mr. Ismail Trading <your-gmail@gmail.com>"
ADMIN_EMAIL="mahmood.atef998@gmail.com"

# ── SITE ──
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"
NEXT_PUBLIC_WHATSAPP_NUMBER="+971501234567"
